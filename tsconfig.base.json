{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@daneshjoam/source"],
    "paths": {
      "@daneshjoam/api-client": ["./libs/api-client/src/index.ts"],
      "@daneshjoam/auth": ["./libs/auth/src/index.ts"],
      "@daneshjoam/shared-types": ["./libs/shared-types/src/index.ts"],
      "@daneshjoam/shared-ui": ["./libs/shared-ui/src/index.ts"]
    }
  }
}
