# Stella Authentication MS (dev)
# Swagger: http://dev.stella.webpanel.systems:3009/api/schema/swagger-ui/

# Direct requests to Stella (visible in DevTools as :3009)
NEXT_PUBLIC_API_URL=http://dev.stella.webpanel.systems:3009

# Optional: proxy via Next.js instead (use /api + rewrites in next.config.js)
# NEXT_PUBLIC_API_URL=/api
# AUTH_API_URL=http://dev.stella.webpanel.systems:3009

# Google reCAPTCHA v2 site key (password login). Falls back to Google's test key if unset.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
