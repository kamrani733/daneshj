# Stella Authentication MS (dev)
# Swagger: http://dev.stella.webpanel.systems:3009/api/schema/swagger-ui/
# Schema:  http://dev.stella.webpanel.systems:3009/schema/  → title "Authentication Microservice API"
#
# Auth paths are `/auth/...` on this host. Notification MS is NOT mounted here
# (`/notification/...` returns Django 404 on :3009).

# Direct requests to Auth MS (visible in DevTools as :3009)
NEXT_PUBLIC_API_URL=http://dev.stella.webpanel.systems:3009

# Notification Microservice (separate host from auth)
# Swagger: http://dev.stella.webpanel.systems:4002/api/schema/swagger-ui/
# Prefer Next.js proxy in local/dev so the browser stays same-origin:
NEXT_PUBLIC_NOTIFICATION_API_URL=/api
NOTIFICATION_API_URL=http://dev.stella.webpanel.systems:4002

# Optional: call Notification MS directly from the browser (may hang / fail locally)
# NEXT_PUBLIC_NOTIFICATION_API_URL=http://dev.stella.webpanel.systems:4002

# Interactive Operations Microservice (follow / like / share / score)
# Swagger (HTTP, not HTTPS): http://dev.stella.webpanel.systems:5001/api/schema/swagger-ui/
# Prefer Next.js proxy in local/dev so the browser stays same-origin:
NEXT_PUBLIC_INTERACTIVE_OPS_API_URL=/api
INTERACTIVE_OPS_API_URL=http://dev.stella.webpanel.systems:5001

# Actor Microservice (private/public panel profiles + service titles)
# Swagger: http://dev.stella.webpanel.systems:3008/api/schema/swagger-ui/
# OpenAPI paths: /profiles_base/..., /profiles_user/..., /profiles_individual/..., /profiles_business/..., /service_titles/...
# Prefer Next.js proxy in local/dev so the browser stays same-origin:
NEXT_PUBLIC_ACTOR_API_URL=/api
ACTOR_API_URL=http://dev.stella.webpanel.systems:3008

# Optional: presentation demo mode on /public-panel (dev or preview only — never in production)
# NEXT_PUBLIC_DEMO_MODE_ENABLED=true

# Google reCAPTCHA v2 site key (password login). Falls back to Google's test key if unset.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
